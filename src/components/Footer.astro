---
import { contact, socials, site } from '../data/site';
const cols = [
  { title: 'Explore', links: [{href:'/school/',label:'The School'},{href:'/teachers/',label:'Our Teachers'},{href:'/courses/',label:'Courses Offered'},{href:'/classes-by-age/',label:'Classes by Age'},{href:'/timetable/',label:'Timetable'},{href:'/term-dates/',label:'Term Dates 2027'},{href:'/gallery/',label:'Photo Gallery'}] },
  { title: 'Courses', links: [{href:'/courses/bharatanatyam/',label:'Bharatanatyam'},{href:'/courses/mohiniyattam/',label:'Mohiniyattam'},{href:'/courses/kuchipudi/',label:'Kuchipudi'},{href:'/courses/hip-hop/',label:'Hip Hop'},{href:'/arangetram/',label:'Arangetram'},{href:'/performances/',label:'Hire the Troupe'}] },
  { title: 'Support', links: [{href:'/first-class/',label:'Your First Class'},{href:'/enrol/',label:'Enrol Now'},{href:'/pricing/',label:'Pricing & Fees'},{href:'/child-safety/',label:'Child Safety'},{href:'/events/',label:'Events'},{href:'/faq/',label:'FAQ'},{href:'/testimonials/',label:'Testimonials'},{href:'/blog/',label:'Blog'},{href:'/contact/',label:'Contact Us'},{href:'/privacy/',label:'Privacy Policy'},{href:'/terms/',label:'Terms'}] },
];
---
<footer class="bg-ink px-4 pb-8 pt-12 text-cream sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-10 border-b border-white/15 pb-10 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <p class="font-script text-4xl text-gold">Veena's School</p>
        <p class="mt-1 font-display text-lg font-bold">of Indian Dances</p>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-cream/75">Classical and contemporary dance in Melbourne — taught with rigour, patience and joy since 2008 (mock history).</p>
        <p class="mt-4 text-sm font-semibold"><a href={contact.phoneHref} class="inline-block py-1 hover:text-gold">{contact.phoneIntl}</a></p>
        <p class="text-sm font-semibold"><a href={`mailto:${contact.email}`} class="inline-block break-all py-1 hover:text-gold">{contact.email}</a></p>
        <p class="mt-1 text-xs text-cream/70">{contact.address}</p>
        <a href="/book-trial/" class="mt-5 inline-block rounded-full bg-saffron px-5 py-3 text-sm font-bold text-ink transition hover:bg-gold">Book a Free Trial Class</a>
        <form id="newsletter-form" class="mt-7" novalidate>
          <label for="nl-email" class="text-sm font-bold text-gold">Term news & event invitations</label>
          <div class="mt-2 flex max-w-sm gap-2">
            <input id="nl-email" type="email" autocomplete="email" placeholder="Parent email address" class="min-w-0 flex-1 rounded-full border border-white/25 bg-white/10 px-4 py-3 text-sm text-cream placeholder:text-cream/60" />
            <button type="submit" class="shrink-0 rounded-full bg-crimson px-5 py-3 text-sm font-bold text-cream ring-1 ring-white/25 transition hover:bg-flame">Join</button>
          </div>
          <p id="nl-email-error" class="field-error invisible text-red-300" role="alert"></p>
          <p id="nl-success" class="mt-2 hidden text-sm font-semibold text-gold">You're on the list — see you at the next event (mock signup).</p>
        </form>
      </div>
      {cols.map((c) => (<div><h3 class="text-sm font-bold uppercase tracking-wider text-gold">{c.title}</h3><ul class="mt-3 space-y-1 text-sm">{c.links.map((l) => (<li><a href={l.href} class="inline-block py-1 text-cream/75 transition hover:text-cream hover:underline">{l.label}</a></li>))}</ul></div>))}
    </div>
    <div class="flex flex-col items-center justify-between gap-4 pt-6 sm:flex-row">
      <p class="text-xs text-cream/70">© {site.year} {site.name}. All rights reserved. Mock demo content — confirm real details before launch.</p>
      <div class="flex items-center gap-2">{socials.map((s) => (<a href={s.href} target="_blank" rel="noopener" class="grid h-11 w-11 place-items-center rounded-full border border-white/25 text-[11px] font-bold transition hover:border-gold hover:text-gold"><span aria-hidden="true">{s.label.slice(0,2).toUpperCase()}</span><span class="sr-only">{s.label} — {s.handle}</span></a>))}</div>
    </div>
  </div>
</footer>
<nav aria-label="Quick contact" class="sticky bottom-0 z-40 grid grid-cols-2 bg-crimson text-cream md:hidden">
  <a href={contact.phoneHref} class="py-3.5 text-center text-sm font-bold">Call Now</a>
  <a href="/book-trial/" class="bg-flame py-3.5 text-center text-sm font-bold">Free Trial</a>
</nav>
