---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page Not Found — Veena's School of Indian Dances" robots="noindex">
  <section class="px-4 py-20 text-center sm:px-6">
    <p class="font-script text-6xl text-crimson">Oops — a missed beat</p>
    <h1 class="mt-3 font-display text-4xl font-bold">This page has danced away (404)</h1>
    <p class="mx-auto mt-4 max-w-md text-ink/70">The page you're looking for doesn't exist. Let's get you back in rhythm:</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-crimson px-6 py-3.5 font-bold text-cream hover:bg-crimson-deep">Home</a>
      <a href="/courses/" class="rounded-full border-2 border-crimson px-6 py-3.5 font-bold text-crimson hover:bg-mist">Courses</a>
      <a href="/book-trial/" class="rounded-full bg-saffron px-6 py-3.5 font-bold text-ink hover:bg-gold">Book a Free Trial</a>
    </div>
  </section>
</Layout>
