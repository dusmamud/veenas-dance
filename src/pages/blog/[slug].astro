---
import Layout from '../../layouts/Layout.astro';
import CtaBand from '../../components/CtaBand.astro';
import { blogPosts } from '../../data/site';
export function getStaticPaths() { return blogPosts.map((p) => ({ params: { slug: p.slug }, props: { post: p } })); }
const { post } = Astro.props;
const fmt = new Date(post.date + 'T00:00:00').toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
const ld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, datePublished: post.date, author: { '@type': 'Person', name: post.author }, image: `https://veenasschoolofindiandances.pages.dev${post.img}` };
const others = blogPosts.filter((p) => p.slug !== post.slug);
---
<Layout title={`${post.title} — Veena's School Blog`} description={post.excerpt} jsonLd={ld} ogType="article" publishedTime={post.date} ogImage={`https://veenasschoolofindiandances.pages.dev${post.img}`}>
  <section class="bg-mist px-4 pb-10 pt-12 sm:px-6">
    <div class="mx-auto max-w-3xl">
      <p data-hero class="text-xs font-bold uppercase tracking-widest text-flame">{post.category} · {fmt} · {post.readingTime}</p>
      <h1 data-hero class="mt-2 font-display text-3xl font-bold leading-tight sm:text-4xl">{post.title}</h1>
      <p data-hero class="mt-3 text-sm text-ink/60">By {post.author}, {post.authorRole}</p>
    </div>
  </section>
  <article class="px-4 py-10 sm:px-6">
    <div class="mx-auto max-w-3xl">
      <figure class="reveal overflow-hidden rounded-[2rem]"><img src={post.img} alt="" width="1100" height="700" class="aspect-[16/10] w-full object-cover" /></figure>
      {post.body.map((para) => (<p class="reveal mt-5 text-[1.05rem] leading-[1.75] text-ink/80">{para}</p>))}
      <div class="reveal mt-10 rounded-3xl bg-mist p-6">
        <h2 class="font-display text-xl font-bold">Keep reading</h2>
        <ul class="mt-3 space-y-2">{others.map((o) => (<li><a href={`/blog/${o.slug}/`} class="font-semibold text-crimson hover:underline">{o.title}</a></li>))}</ul>
      </div>
    </div>
  </article>
  <CtaBand />
</Layout>
