---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { blogPosts } from '../../data/site';
const fmt = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Layout title="Blog — Dance Guides for Students & Parents | Veena's School" description="Beginner guides, Arangetram explainers and form comparisons from the teachers at Veena's School of Indian Dances.">
  <PageHero script="Blog" title="Notes from the studio" lead="Guides for beginners and honest explainers for parents, written by our teachers." />
  <section class="px-4 py-12 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-3">
      {blogPosts.map((p) => (<article class="course-card reveal overflow-hidden rounded-3xl bg-white ring-1 ring-line"><a href={`/blog/${p.slug}/`} class="block overflow-hidden"><img src={p.img} alt={p.title} width="800" height="550" loading="lazy" class="aspect-[16/11] w-full object-cover" /></a><div class="p-5"><p class="text-xs font-bold uppercase tracking-widest text-flame">{p.category} · {fmt(p.date)} · {p.readingTime}</p><h2 class="mt-2 font-display text-xl font-bold leading-snug"><a href={`/blog/${p.slug}/`} class="hover:text-crimson">{p.title}</a></h2><p class="mt-2 text-sm leading-relaxed text-ink/70">{p.excerpt}</p><a href={`/blog/${p.slug}/`} class="mt-3 inline-flex min-h-[44px] items-center font-bold text-crimson hover:underline">Read the guide →</a></div></article>))}
    </div>
  </section>
  <CtaBand />
</Layout>
