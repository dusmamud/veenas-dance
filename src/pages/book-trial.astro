---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { courses, contact } from '../data/site';
const inputCls = 'w-full rounded-2xl border border-line bg-white px-4 py-3.5 outline-none focus:border-crimson';
---
<Layout title="Book a Free Trial Class — Veena's School of Indian Dances" description="Book a free trial class in Bharatanatyam, Mohiniyattam, Kuchipudi or Hip Hop in Melbourne. Parents: tell us the student's age, course and experience.">
  <PageHero script="Free Trial" title="Book a free trial class" lead="Parents, fill this in for your child (adult students, for yourselves). We reply within one business day with a class time. No payment, no obligation." />
  <section class="px-4 py-12 sm:px-6">
    <div class="mx-auto grid max-w-6xl items-start gap-10 lg:grid-cols-[1.5fr_1fr]">
      <div class="reveal rounded-3xl bg-white p-6 ring-1 ring-line sm:p-8">
        <form id="trial-form" novalidate class="grid gap-5 sm:grid-cols-2">
          <div><label for="tf-parent" class="mb-1.5 block text-sm font-bold">Parent / guardian name *</label><input id="tf-parent" type="text" required autocomplete="name" class={inputCls} aria-describedby="tf-parent-error" /><p id="tf-parent-error" class="field-error invisible text-red-700" role="alert"></p></div>
          <div><label for="tf-email" class="mb-1.5 block text-sm font-bold">Email *</label><input id="tf-email" type="email" required autocomplete="email" class={inputCls} aria-describedby="tf-email-error" /><p id="tf-email-error" class="field-error invisible text-red-700" role="alert"></p></div>
          <div><label for="tf-phone" class="mb-1.5 block text-sm font-bold">Phone</label><input id="tf-phone" type="tel" autocomplete="tel" class={inputCls} /></div>
          <div><label for="tf-age" class="mb-1.5 block text-sm font-bold">Student age *</label><input id="tf-age" type="text" inputmode="numeric" required placeholder="e.g. 8" class={inputCls} aria-describedby="tf-age-error" /><p id="tf-age-error" class="field-error invisible text-red-700" role="alert"></p></div>
          <div><label for="tf-course" class="mb-1.5 block text-sm font-bold">Course *</label><select id="tf-course" required class={inputCls} aria-describedby="tf-course-error"><option value="">Choose a course…</option>{courses.map((c) => (<option value={c.title}>{c.title} ({c.ages})</option>))}<option value="Not sure">Not sure — advise me</option></select><p id="tf-course-error" class="field-error invisible text-red-700" role="alert"></p></div>
          <div><label for="tf-exp" class="mb-1.5 block text-sm font-bold">Experience</label><select id="tf-exp" class={inputCls}><option>Complete beginner</option><option>Some dance experience</option><option>1–3 years classical training</option><option>Advanced / Arangetram track</option></select></div>
          <div class="sm:col-span-2"><label for="tf-notes" class="mb-1.5 block text-sm font-bold">Anything we should know?</label><textarea id="tf-notes" rows="3" class={inputCls} placeholder="Preferred days, questions, goals…"></textarea></div>
          <div class="sm:col-span-2"><button type="submit" class="w-full rounded-full bg-crimson px-7 py-4 font-bold text-cream transition hover:bg-crimson-deep sm:w-auto">Request My Free Trial</button><p class="mt-3 text-xs text-ink/75">Demo form — no data is sent or stored. On the live site this connects to the school's inbox.</p></div>
        </form>
        <div id="trial-success" class="hidden text-center py-8" role="status">
          <p class="font-script text-5xl text-crimson">Thank you!</p>
          <h2 class="mt-2 font-display text-2xl font-bold">Your trial request is in.</h2>
          <p class="mx-auto mt-3 max-w-md text-ink/70">We will email you within one business day with a class time. Wear comfortable clothes, bring a water bottle — and arrive 10 minutes early. We can't wait to dance with you.</p>
          <a href="/timetable/" class="mt-5 inline-block font-bold text-crimson hover:underline">Browse the timetable meanwhile →</a>
          <p class="mt-3"><a href="/first-class/" class="font-bold text-crimson hover:underline">Read: what to bring & wear to your first class →</a> · <a href="/enrol/" class="font-bold text-crimson hover:underline">Ready already? Enrol now →</a></p>
        </div>
      </div>
      <aside class="reveal space-y-5">
        <div class="rounded-3xl bg-mist p-6"><h2 class="font-display text-xl font-bold">What happens next?</h2><ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-ink/75"><li>We confirm a trial class by email within one business day.</li><li>Arrive 10 minutes early; parents may watch the trial.</li><li>After class, Veena recommends the right batch and level.</li><li>Enrol only if it feels right — term fees are on the Pricing page.</li></ol></div>
        <div class="rounded-3xl bg-ink p-6 text-cream"><h2 class="font-display text-xl font-bold">Prefer to talk?</h2><p class="mt-2 text-sm text-cream/80">Call <a href={contact.phoneHref} class="font-bold text-gold hover:underline">{contact.phoneDisplay}</a><br />Email <a href={`mailto:${contact.email}`} class="break-all font-bold text-gold hover:underline">{contact.email}</a></p><p class="mt-2 text-sm text-cream/70">{contact.address}</p></div>
      </aside>
    </div>
  </section>
</Layout>
