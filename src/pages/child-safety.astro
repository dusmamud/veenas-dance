---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { childSafety, contact } from '../data/site';
---
<Layout title="Child Safety — WWCC-Checked Teachers & Victorian Child Safe Standards | Veena's School" description="Our child safety commitment: Victorian Child Safe Standards, Working With Children Checks for every teacher, supervision and pick-up rules, photo consent and how to raise a concern.">
  <PageHero script="Child Safety" title="Safe children, always" lead="Dance should be a place where children feel safe, respected and free to shine. Here is exactly how we protect that — in writing, so you can hold us to it." />
  <section class="px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <figure class="reveal overflow-hidden rounded-[2rem] shadow-lg"><img src={childSafety.img} alt="Teacher guiding young students in class, seen from behind" width="1200" height="700" loading="lazy" class="aspect-[16/8] w-full object-cover" /></figure>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
        {childSafety.commitments.map((c) => (<article class="rounded-3xl bg-white p-6 ring-1 ring-line"><h2 class="font-display text-xl font-bold text-crimson">{c.title}</h2><p class="mt-2 text-sm leading-relaxed text-ink/75">{c.text}</p></article>))}
      </div>
      <div class="mt-12 grid gap-10 lg:grid-cols-2">
        <div class="reveal">
          <h2 class="font-display text-2xl font-bold">Our code of conduct</h2>
          <p class="mt-2 text-ink/75">Every teacher and volunteer agrees to this code before their first class:</p>
          <ul class="mt-4 space-y-3">
            {childSafety.code.map((item) => (<li class="flex gap-3 rounded-2xl bg-mist px-4 py-3 text-sm leading-relaxed"><span aria-hidden="true" class="font-bold text-flame">✓</span><span>{item}</span></li>))}
          </ul>
        </div>
        <div class="reveal rounded-3xl bg-ink p-7 text-cream">
          <h2 class="font-display text-2xl font-bold">Raising a concern</h2>
          <p class="mt-3 leading-relaxed text-cream/85">If anything ever feels wrong — big or small — please tell us. Speak to Guru Veena in person, call <a href={contact.phoneHref} class="font-bold text-gold hover:underline">{contact.phoneDisplay}</a>, or email <a href={`mailto:${contact.email}`} class="break-all font-bold text-gold hover:underline">{contact.email}</a>.</p>
          <p class="mt-3 leading-relaxed text-cream/85">You can also contact the Victorian Commission for Children and Young People directly. Children are always believed first, and concerns are documented and acted on — that is the standard we set for ourselves.</p>
          <a href="/enrol/" class="mt-6 inline-block rounded-full bg-saffron px-6 py-3.5 font-bold text-ink hover:bg-gold">Enrol with confidence</a>
        </div>
      </div>
    </div>
  </section>
  <CtaBand />
</Layout>
