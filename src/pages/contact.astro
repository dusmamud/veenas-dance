---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { contact } from '../data/site';
const inputCls = 'w-full rounded-2xl border border-line bg-white px-4 py-3.5 outline-none focus:border-crimson';
---
<Layout title="Contact Us — Veena's School of Indian Dances, Melbourne" description="Contact Veena's School of Indian Dances: call 0470 552 003, email info@veenasschoolofindiandances.com.au, or visit the Brunswick East studio.">
  <PageHero script="Contact Us" title="We'd love to hear from you" lead="Questions about classes, levels, fees or events — call, email or send a message." />
  <section class="px-4 py-12 sm:px-6">
    <div class="mx-auto grid max-w-6xl items-start gap-10 lg:grid-cols-2">
      <div class="reveal space-y-5">
        <div class="rounded-3xl bg-white p-6 ring-1 ring-line">
          <h2 class="font-display text-xl font-bold">Studio details</h2>
          <dl class="mt-4 space-y-3 text-sm">
            <div><dt class="font-bold text-flame">Phone</dt><dd><a href={contact.phoneHref} class="font-semibold text-crimson hover:underline">{contact.phoneIntl}</a></dd></div>
            <div><dt class="font-bold text-flame">Email</dt><dd><a href={`mailto:${contact.email}`} class="break-all font-semibold text-crimson hover:underline">{contact.email}</a></dd></div>
            <div><dt class="font-bold text-flame">Studio</dt><dd>{contact.address}</dd></div>
            <div><dt class="font-bold text-flame">Hours</dt><dd>{contact.hours}</dd></div>
          </dl>
        </div>
        <div class="grid aspect-[16/9] place-items-center rounded-3xl bg-mist text-center ring-1 ring-line" role="img" aria-label="Map placeholder for the Brunswick East studio location">
          <div><p class="font-display text-lg font-bold">Map — Brunswick East, Melbourne</p><p class="mt-1 px-6 text-sm text-ink/60">Interactive map placeholder (demo). Tram 1 & 6 to Lygon Street; street parking nearby.</p></div>
        </div>
        <img src="/images/studio-wide.webp" alt="Inside the dance studio" width="900" height="600" loading="lazy" class="aspect-[3/2] w-full rounded-3xl object-cover" />
      </div>
      <div class="reveal rounded-3xl bg-white p-6 ring-1 ring-line sm:p-8">
        <h2 class="font-display text-2xl font-bold">Send a message</h2>
        <form id="contact-form" novalidate class="mt-5 grid gap-5">
          <div><label for="cf-name" class="mb-1.5 block text-sm font-bold">Your name *</label><input id="cf-name" type="text" required autocomplete="name" class={inputCls} aria-describedby="cf-name-error" /><p id="cf-name-error" class="field-error invisible text-red-700" role="alert"></p></div>
          <div><label for="cf-email" class="mb-1.5 block text-sm font-bold">Email *</label><input id="cf-email" type="email" required autocomplete="email" class={inputCls} aria-describedby="cf-email-error" /><p id="cf-email-error" class="field-error invisible text-red-700" role="alert"></p></div>
          <div><label for="cf-topic" class="mb-1.5 block text-sm font-bold">Topic</label><select id="cf-topic" class={inputCls}><option>Classes & enrolment</option><option>Fees</option><option>Events & tickets</option><option>Arangetram</option><option>Other</option></select></div>
          <div><label for="cf-message" class="mb-1.5 block text-sm font-bold">Message *</label><textarea id="cf-message" rows="5" required class={inputCls} aria-describedby="cf-message-error"></textarea><p id="cf-message-error" class="field-error invisible text-red-700" role="alert"></p></div>
          <button type="submit" class="rounded-full bg-crimson px-7 py-4 font-bold text-cream transition hover:bg-crimson-deep">Send Message</button>
          <p class="text-xs text-ink/60">Demo form — no data is sent or stored.</p>
        </form>
        <div id="contact-success" class="hidden py-8 text-center" role="status"><p class="font-script text-5xl text-crimson">Thank you!</p><p class="mt-3 text-ink/70">Your message is on its way (demo). We reply within one business day.</p></div>
      </div>
    </div>
  </section>
  <CtaBand />
</Layout>
