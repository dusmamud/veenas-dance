---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { courses, timetable, levels } from '../../data/site';
export function getStaticPaths() { return courses.map((c) => ({ params: { slug: c.slug }, props: { course: c } })); }
const { course } = Astro.props;
const slots = timetable.flatMap((d) => d.classes.filter((cl) => cl.course === course.title).map((cl) => ({ day: d.day, ...cl })));
const ld = { '@context': 'https://schema.org', '@type': 'Course', name: course.title, description: course.short, provider: { '@type': 'DanceSchool', name: "Veena's School of Indian Dances" } };
---
<Layout title={`${course.title} Classes in Melbourne — Veena's School of Indian Dances`} description={course.short} jsonLd={ld} ogImage={`https://veenasschoolofindiandances.pages.dev${course.img}`}>
  <PageHero eyebrow={course.origin} title={`${course.title} Classes`} lead={course.tagline} />
  <section class="px-4 py-12 sm:px-6">
    <div class="mx-auto grid max-w-6xl items-start gap-10 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <figure class="reveal overflow-hidden rounded-[2rem]"><img src={course.heroImg} alt={`${course.title} dancer`} width="1100" height="750" loading="eager" class="aspect-[3/2] w-full object-cover" /></figure>
        {course.about.map((p) => (<p class="reveal mt-5 leading-relaxed text-ink/75">{p}</p>))}
        <h2 class="reveal mt-10 font-display text-2xl font-bold">What you'll learn</h2>
        <ul class="reveal mt-4 grid gap-2 sm:grid-cols-2">{course.learn.map((l) => (<li class="flex gap-2 rounded-2xl bg-mist px-4 py-3 text-sm font-medium"><span aria-hidden="true" class="text-flame">✦</span>{l}</li>))}</ul>
        <h2 class="reveal mt-10 font-display text-2xl font-bold">Your path: {levels.join(' → ')}</h2>
        <p class="reveal mt-3 leading-relaxed text-ink/70">Students are assessed kindly each term and move up when ready — never by age alone, never held back without a conversation with parents.</p>
      </div>
      <aside class="reveal space-y-5 lg:sticky lg:top-28">
        <div class="rounded-3xl bg-white p-6 ring-1 ring-line">
          <h2 class="font-display text-xl font-bold">Class facts</h2>
          <dl class="mt-4 space-y-3 text-sm">
            <div><dt class="font-bold text-flame">Ages</dt><dd>{course.ages}</dd></div>
            <div><dt class="font-bold text-flame">Duration</dt><dd>{course.duration}</dd></div>
            <div><dt class="font-bold text-flame">Fees</dt><dd>{course.feeHint} — see <a href="/pricing/" class="font-semibold text-crimson hover:underline">full pricing</a></dd></div>
            <div><dt class="font-bold text-flame">Dress code</dt><dd>{course.dress}</dd></div>
          </dl>
          <a href="/book-trial/" class="mt-5 block rounded-full bg-crimson px-6 py-3.5 text-center font-bold text-cream hover:bg-crimson-deep">Book a Free Trial Class</a>
        </div>
        <div class="rounded-3xl bg-mist p-6">
          <h2 class="font-display text-xl font-bold">{course.title} timetable</h2>
          {slots.length ? (<ul class="mt-3 space-y-3 text-sm">{slots.map((s) => (<li class="rounded-2xl bg-white px-4 py-3"><span class="font-bold">{s.day} · {s.time}</span><br />{s.name}<br /><span class="text-ink/60">{s.age} · {s.studio} · Teacher: {s.teacher}</span></li>))}</ul>) : (<p class="mt-2 text-sm text-ink/70">New batches each term — <a href="/contact/" class="font-semibold text-crimson hover:underline">ask us</a> for the next intake.</p>)}
          <a href="/timetable/" class="mt-4 inline-block font-bold text-crimson hover:underline">Full timetable →</a>
        </div>
      </aside>
    </div>
  </section>
  <CtaBand />
</Layout>
