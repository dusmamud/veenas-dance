---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { pricing } from '../data/site';
---
<Layout title="Pricing & Fees — Veena's School of Indian Dances" description="Transparent dance school fees in AUD: term fees, registration, discounts, costume and missed-class policies — all in plain text.">
  <PageHero script="Pricing" title="Honest fees, no surprises" lead={`All fees are per ${pricing.termWeeks}-week Victorian school term, in Australian dollars. Your first trial class is always free.`} />
  <section class="px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-4xl">
      <div class="reveal overflow-hidden rounded-3xl bg-white ring-1 ring-line">
        <table class="w-full text-left text-sm sm:text-base">
          <caption class="sr-only">Fee schedule</caption>
          <thead><tr class="bg-mist"><th scope="col" class="px-5 py-4 font-display">Item</th><th scope="col" class="px-5 py-4 font-display">Fee</th></tr></thead>
          <tbody class="divide-y divide-line">{pricing.rows.map((r) => (<tr><td class="px-5 py-4">{r.item}</td><td class="whitespace-nowrap px-5 py-4 font-bold text-crimson">{r.price}</td></tr>))}</tbody>
        </table>
      </div>
      <h2 class="mt-12 font-display text-2xl font-bold reveal">Discounts</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-3">{pricing.discounts.map((d) => (<article class="reveal rounded-3xl bg-mist p-6"><h3 class="font-display text-lg font-bold text-crimson">{d.title}</h3><p class="mt-2 text-sm leading-relaxed text-ink/70">{d.text}</p></article>))}</div>
      <h2 class="mt-12 font-display text-2xl font-bold reveal">Policies, in plain words</h2>
      <div class="mt-5 grid gap-5 sm:grid-cols-2">{pricing.policies.map((p) => (<article class="reveal rounded-3xl bg-white p-6 ring-1 ring-line"><h3 class="font-bold">{p.title}</h3><p class="mt-2 text-sm leading-relaxed text-ink/70">{p.text}</p></article>))}</div>
    </div>
  </section>
  <CtaBand />
</Layout>
