---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { guru, teachers, timeline, parentInfo, contact } from '../data/site';
---
<Layout title="The School & Guru Veena — Veena's School of Indian Dances, Melbourne" description="Meet Guru Veena Nair, our teachers, philosophy and history — and everything parents need to know before the first class.">
  <PageHero script="The School" title="Tradition, taught with patience and joy" lead="Veena's School of Indian Dances is a Melbourne classical dance school built on one belief: rigour and joy belong in the same classroom." />
  <section class="px-4 py-12 sm:px-6">
    <div class="mx-auto grid max-w-6xl items-start gap-10 md:grid-cols-2">
      <figure class="reveal overflow-hidden rounded-[2rem] shadow-lg"><img src={guru.img} alt="Guru Veena Nair, founder of Veena's School of Indian Dances" width="900" height="1000" loading="lazy" class="aspect-[4/5] w-full object-cover" /></figure>
      <div class="reveal">
        <p class="text-xs font-bold uppercase tracking-widest text-flame">Founder, Guru & Artistic Director</p>
        <h2 class="mt-1 font-display text-3xl font-bold">{guru.name}</h2>
        {guru.bio.map((p) => (<p class="mt-4 leading-relaxed text-ink/70">{p}</p>))}
        <h3 class="mt-6 font-display text-xl font-bold">Credentials</h3>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-ink/75">{guru.credentials.map((c) => (<li class="flex gap-2"><span aria-hidden="true" class="text-flame">✦</span>{c}</li>))}</ul>
      </div>
    </div>
  </section>
  <section class="bg-mist px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-display text-3xl font-bold reveal">Our teachers</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {teachers.map((t) => (<article class="reveal overflow-hidden rounded-3xl bg-white ring-1 ring-line"><img src={t.img} alt="" width="700" height="500" loading="lazy" class="aspect-[7/5] w-full object-cover" /><div class="p-5"><h3 class="font-display text-xl font-bold">{t.name}</h3><p class="text-sm font-semibold text-flame">{t.role}</p><p class="mt-2 text-sm text-ink/70">{t.text}</p></div></article>))}
      </div>
    </div>
  </section>
  <section class="px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-display text-3xl font-bold reveal">Our story</h2>
      <ol class="mt-8 space-y-6">
        {timeline.map((t) => (<li class="reveal flex gap-5"><span class="font-display text-2xl font-bold text-crimson">{t.year}</span><div><h3 class="font-bold">{t.title}</h3><p class="mt-1 text-sm leading-relaxed text-ink/70">{t.text}</p></div></li>))}
      </ol>
      <figure class="reveal mt-10 overflow-hidden rounded-[2rem]"><img src="/images/studio-wide.webp" alt="Inside the Brunswick East studio" width="1200" height="700" loading="lazy" class="aspect-[16/9] w-full object-cover" /></figure>
      <p class="mt-3 text-sm text-ink/60">{contact.address} · {contact.hours}</p>
    </div>
  </section>
  <section class="bg-mist px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-display text-3xl font-bold reveal">For parents — good to know</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {parentInfo.map((p) => (<article class="reveal rounded-3xl bg-white p-6 ring-1 ring-line"><h3 class="font-display text-lg font-bold text-crimson">{p.title}</h3><p class="mt-2 text-sm leading-relaxed text-ink/70">{p.text}</p></article>))}
      </div>
    </div>
  </section>
  <CtaBand />
</Layout>
