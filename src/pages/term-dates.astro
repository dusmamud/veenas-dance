---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { terms2027, keyDates2027 } from '../data/site';
---
<Layout title="Term Dates 2027 — Terms, Holidays, Exams & Recital Dates | Veena's School" description="2027 term dates in plain text: four 10-week terms following Victorian school terms, public holiday closures, exam weeks, Taal recital and showcase dates.">
  <PageHero script="Term Dates" title="2027 term dates & calendar" lead="Four 10-week terms following the Victorian school calendar. Everything in plain text — no PDF to download, no poster to squint at." />
  <section class="px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-6 md:grid-cols-2" data-reveal-group>
        {terms2027.map((t) => (<article class="rounded-3xl bg-white p-6 ring-1 ring-line"><p class="text-xs font-bold uppercase tracking-widest text-flame">{t.weeks} weeks</p><h2 class="mt-1 font-display text-2xl font-bold text-crimson">{t.term}</h2><p class="mt-1 font-semibold">{t.dates}</p><p class="mt-3 text-sm leading-relaxed text-ink/75">{t.notes}</p></article>))}
      </div>
      <div class="mt-12 reveal">
        <h2 class="font-display text-2xl font-bold">Key dates for the diary</h2>
        <ul class="mt-5 divide-y divide-line rounded-3xl bg-white ring-1 ring-line">
          {keyDates2027.map((k) => (<li class="flex flex-wrap items-center justify-between gap-2 px-5 py-4"><span class="font-bold text-flame">{k.date}</span><a href={k.href} class="font-semibold hover:text-crimson hover:underline">{k.event} →</a></li>))}
        </ul>
        <p class="mt-5 text-sm text-ink/75">No classes on Victorian public holidays — affected batches receive a make-up class in the same term. Dates are mock placeholders for the demo; the confirmed calendar is emailed to enrolled families each December.</p>
      </div>
    </div>
  </section>
  <CtaBand />
</Layout>
