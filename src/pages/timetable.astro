---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { timetable, courses } from '../data/site';
const days = timetable.map((d) => d.day);
const forms = courses.map((c) => c.title);
---
<Layout title="Class Timetable — Veena's School of Indian Dances, Melbourne" description="Weekly class timetable in text: filter by day and dance form — day, time, class, age range, level, duration, teacher and studio for every batch.">
  <PageHero script="Timetable" title="Weekly class timetable" lead="Every class, in plain text — filter by day or dance form. Arrive 10 minutes early; classes start on time." />
  <section class="px-4 py-12 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="reveal rounded-3xl bg-white p-5 ring-1 ring-line" id="timetable-filter">
        <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter by day">
          <span class="mr-1 text-sm font-bold">Day:</span>
          <button type="button" data-day-filter="All" aria-pressed="true" class="tt-filter-btn min-h-[44px] rounded-full bg-crimson px-4 py-2 text-sm font-bold text-cream">All days</button>
          {days.map((d) => (<button type="button" data-day-filter={d} aria-pressed="false" class="tt-filter-btn min-h-[44px] rounded-full bg-mist px-4 py-2 text-sm font-bold text-ink">{d}</button>))}
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-2" role="group" aria-label="Filter by dance form">
          <span class="mr-1 text-sm font-bold">Form:</span>
          <button type="button" data-form-filter="All" aria-pressed="true" class="tt-filter-btn min-h-[44px] rounded-full bg-crimson px-4 py-2 text-sm font-bold text-cream">All forms</button>
          {forms.map((f) => (<button type="button" data-form-filter={f} aria-pressed="false" class="tt-filter-btn min-h-[44px] rounded-full bg-mist px-4 py-2 text-sm font-bold text-ink">{f}</button>))}
        </div>
        <p id="timetable-count" class="mt-3 text-sm text-ink/75" role="status">Showing all classes</p>
      </div>

      <div class="mt-10 space-y-10">
        {timetable.map((d) => (
          <div class="reveal" data-day-block={d.day}>
            <h2 class="font-display text-2xl font-bold text-crimson">{d.day}</h2>
            <div class="mt-4 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {d.classes.map((c) => (<article data-tt-card data-course={c.course} class="rounded-3xl bg-white p-5 ring-1 ring-line"><p class="text-sm font-bold text-flame">{c.time}</p><h3 class="mt-1 font-display text-lg font-bold">{c.name}</h3><dl class="mt-2 space-y-1 text-sm text-ink/70"><div class="flex gap-2"><dt class="font-semibold text-ink">Age:</dt><dd>{c.age}</dd></div><div class="flex gap-2"><dt class="font-semibold text-ink">Level:</dt><dd>{c.level}</dd></div><div class="flex gap-2"><dt class="font-semibold text-ink">Duration:</dt><dd>{c.duration}</dd></div><div class="flex gap-2"><dt class="font-semibold text-ink">Teacher:</dt><dd>{c.teacher} · {c.studio}</dd></div></dl><a href="/book-trial/" class="mt-3 inline-flex min-h-[44px] items-center font-bold text-crimson hover:underline">Book a free trial in this class →</a></article>))}
            </div>
          </div>
        ))}
      </div>
      <p class="mt-10 text-sm text-ink/75">Term dates follow Victorian school terms (10 weeks) — see <a href="/term-dates/" class="font-bold text-crimson hover:underline">Term Dates 2027</a>. No classes on public holidays — affected batches receive a make-up class.</p>
    </div>
  </section>
  <CtaBand />
</Layout>
